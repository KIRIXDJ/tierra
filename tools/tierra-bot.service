[Unit]
Description=Bot de Telegram de TIERRA (Elio)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/yanobeb0/Documentos/Proyectos/tierra
EnvironmentFile=/home/yanobeb0/Documentos/Proyectos/tierra/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 tools/bot_elio.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
