# Copia este archivo a .env y coloca tu clave de api.nasa.gov.
# Sin clave, APOD usa su página oficial y NeoWs queda deshabilitado.
NASA_API_KEY=

# IA de Elio (preguntas libres). Vacías = valores por defecto del código;
# sin IA_API_KEY el bot responde solo con comandos.
IA_API_KEY=
IA_URL=
IA_MODELO=
